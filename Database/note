  let query = fs.readFileSync('query.sql', 'utf8');

  // Replace placeholder with user input
  query = query.replace('<<BRAND>>', userInput);

  // use params to safely pass user input to the query, preventing SQL injection attacks.
  query = 'SELECT * FROM cars WHERE brand = $1';

